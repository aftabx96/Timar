# Local development settings. Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string

# Database
# Empty: uses the bundled PGlite database in backend/.data (nothing to install).
# Neon: Dashboard > your project > Connect > copy the connection string, for example
#   postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=

# Email for one time codes
# Empty SMTP_HOST: codes are printed to the console and shown in the frontend dev inbox.
# Gmail: turn on 2-Step Verification, then create an app password at
#   https://myaccount.google.com/apppasswords  and paste the 16 letters (spaces do not matter).
#   MAIL_FROM must use the same Gmail address.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Timar <no-reply@timar.test>"

CLIENT_ORIGIN=http://localhost:5173
